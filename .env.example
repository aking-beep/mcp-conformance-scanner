# Optional. Basic scanning works with defaults; set these for production launches.

# --- Access gate (pre-scan signup) ---
# On by default. Set to false to allow anonymous scans (not recommended for public launch).
ACCESS_GATE_ENABLED=true
# HMAC secret for access tokens (set a long random string in production)
ACCESS_GATE_SECRET=
# Where to POST new leads (Slack/Make/Airtable/etc.). Falls back to EMAIL_CAPTURE_WEBHOOK_URL.
LEAD_WEBHOOK_URL=

# Optional email delivery of saved-report links
EMAIL_CAPTURE_WEBHOOK_URL=

# Optional feedback webhook (Slack/Discord/whatever). Leave blank to log to console.
FEEDBACK_WEBHOOK_URL=

# Public base URL for absolute share links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Saved reports (explicit opt-in; 30-day TTL) ---
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# REPORT_STORE_DIR=.data/reports

# --- Rate limits (per IP per hour) ---
# RATE_LIMIT_SCAN=20
# RATE_LIMIT_BADGE=60
# RATE_LIMIT_REPORTS=30
# RATE_LIMIT_ACCESS=30

# Optional GitHub token for repo / ghcr scans
GITHUB_TOKEN=

# Optional bearer for private OCI registries
DOCKER_REGISTRY_TOKEN=

# Set to 1 to also run local `docker image inspect` after a successful registry fetch
MCP_DOCKER_LOCAL=
