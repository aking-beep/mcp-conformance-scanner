# Optional. Basic scanning works with defaults; set these for production launches.

# --- Access gate (pre-scan signup) ---
# Off by default for public launch (scan instantly; capture email on save/share).
ACCESS_GATE_ENABLED=false
# Required in production / Vercel whenever the gate is on (or tokens are minted).
ACCESS_GATE_SECRET=

# --- Airtable (optional durable store when gate / lead capture is used) ---
# 1) Create a base + table (default Signups) — see docs/AIRTABLE_LEADS.md
# 2) Personal Access Token: https://airtable.com/create/tokens
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE=Signups

# Optional secondary notify (Slack/Make). Not required if Airtable is set.
LEAD_WEBHOOK_URL=

# Optional email delivery of saved-report links
EMAIL_CAPTURE_WEBHOOK_URL=

# Optional feedback webhook
FEEDBACK_WEBHOOK_URL=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Rate limits + saved reports (strongly recommended on Vercel) ---
# Create a free Redis DB at https://console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# REPORT_STORE_DIR=.data/reports

# RATE_LIMIT_SCAN=20
# RATE_LIMIT_BADGE=60
# RATE_LIMIT_REPORTS=30
# RATE_LIMIT_ACCESS=30

GITHUB_TOKEN=
DOCKER_REGISTRY_TOKEN=
MCP_DOCKER_LOCAL=
