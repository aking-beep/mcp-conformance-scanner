# Optional. Basic scanning works with defaults; set these for production launches.

# --- Access gate (pre-scan signup) ---
ACCESS_GATE_ENABLED=true
ACCESS_GATE_SECRET=

# --- Airtable (recommended durable store for leads) ---
# 1) Create a base + table named "Leads" with columns listed in lib/access/airtable.ts
# 2) Create a Personal Access Token at https://airtable.com/create/tokens
#    Scopes: data.records:write (+ data.records:read optional)
#    Access: add this base
# 3) Base ID is in the base URL: airtable.com/appXXXXXXXX/...
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE=Leads

# Optional secondary notify (Slack/Make). Not required if Airtable is set.
LEAD_WEBHOOK_URL=

# Optional email delivery of saved-report links
EMAIL_CAPTURE_WEBHOOK_URL=

# Optional feedback webhook
FEEDBACK_WEBHOOK_URL=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Saved reports ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REPORT_STORE_DIR=.data/reports

# RATE_LIMIT_SCAN=20
# RATE_LIMIT_BADGE=60
# RATE_LIMIT_REPORTS=30
# RATE_LIMIT_ACCESS=30

GITHUB_TOKEN=
DOCKER_REGISTRY_TOKEN=
MCP_DOCKER_LOCAL=
