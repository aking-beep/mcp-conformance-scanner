# Optional. Only needed for the email-capture feature (saving reports / updates).
# Basic scanning works with NONE of these set.

# Where to POST captured emails (e.g. a form endpoint, Airtable, or your own API).
# Leave blank to disable email delivery. Report persistence is separate (see below).
EMAIL_CAPTURE_WEBHOOK_URL=

# Optional feedback webhook (Slack/Discord/whatever). Leave blank to log to console.
FEEDBACK_WEBHOOK_URL=

# Public base URL, used for building shareable report links. Optional.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Saved reports (explicit opt-in only; 30-day TTL) ---
# Production (recommended): Upstash Redis REST
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
#
# Or a filesystem directory (fine for local/dev; default .data/reports when NODE_ENV≠production)
# REPORT_STORE_DIR=.data/reports

# Optional GitHub token — raises API rate limits for repository scans (and enables private repos).
# Also used as a bearer for ghcr.io pulls when scanning private images.
# Create a classic PAT with public_repo (or repo for private). Leave blank for unauthenticated (60 req/hr).
GITHUB_TOKEN=

# Optional bearer for private OCI registries (Docker Hub org tokens, GHCR, etc.).
DOCKER_REGISTRY_TOKEN=

# Set to 1 to also run local `docker image inspect` after a successful registry fetch.
MCP_DOCKER_LOCAL=
